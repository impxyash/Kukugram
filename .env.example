# Local PostgreSQL settings. Use a unique local-only password and use that
# same value in DATABASE_URL. These values are consumed by Docker Compose.
POSTGRES_DB=kukugram
POSTGRES_USER=kukugram
POSTGRES_PASSWORD=replace-with-a-unique-local-only-password
DATABASE_URL=postgresql://kukugram:replace-with-a-unique-local-only-password@localhost:5432/kukugram

# Local Redis dependency used by the API.
REDIS_URL=redis://localhost:6379

# Public browser API origin. Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# API runtime configuration.
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=kukugram_session
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret-at-least-32-characters

# Configure OAuth providers only when their sign-in flows are implemented.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
